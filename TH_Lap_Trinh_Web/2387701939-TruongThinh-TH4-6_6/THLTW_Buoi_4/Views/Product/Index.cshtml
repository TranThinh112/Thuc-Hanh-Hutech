@model IEnumerable<THLTW_buoi_4.Models.Product>

<h2>Danh sách sản phẩm</h2>

<div class="row">
@foreach(var item in Model)
{
    <div class="col-md-3">
        <div class="card mb-3">
            <img src="@item.ImageUrl"
                 class="card-img-top"
                 style="height:250px;object-fit:cover">

            <div class="card-body">
                <h5>@item.Name</h5>
                <p>@item.Price.ToString("N0") VNĐ</p>

                <a style="margin-left: 15px;" asp-action="Display"
                   asp-route-id="@item.Id"
                   class="btn btn-primary">
                    Xem chi tiết
                </a>
                
            </div>
        </div>
    </div>
}
</div>