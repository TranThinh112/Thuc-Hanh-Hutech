@model Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Quản lý sản phẩm</p>
        <h1>Thêm sản phẩm</h1>
    </div>
    <a class="btn" asp-action="Index">Quay lại</a>
</section>

<section class="form-panel">
    <form asp-action="Create" method="post" class="product-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price">Giá</label>
            <input asp-for="Price" class="form-control" type="number" min="0" step="1000" />
            <span asp-validation-for="Price" class="field-validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="field-validation"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
            <a class="btn" asp-action="Index">Hủy</a>
        </div>
    </form>
</section>
