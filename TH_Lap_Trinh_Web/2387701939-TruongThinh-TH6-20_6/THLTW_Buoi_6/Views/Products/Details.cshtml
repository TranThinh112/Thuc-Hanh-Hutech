@model Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Quản lý sản phẩm</p>
        <h1>Chi tiết sản phẩm</h1>
    </div>
    <a class="btn" asp-action="Index">Quay lại</a>
</section>

<section class="detail-panel">
    <dl class="detail-list">
        <div>
            <dt>Mã sản phẩm</dt>
            <dd>#@Model.Id</dd>
        </div>
        <div>
            <dt>Tên sản phẩm</dt>
            <dd>@Model.Name</dd>
        </div>
        <div>
            <dt>Giá</dt>
            <dd>@Model.Price.ToString("N0") đ</dd>
        </div>
        <div>
            <dt>Mô tả</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "Không có mô tả" : Model.Description)</dd>
        </div>
    </dl>

    <div class="form-actions">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Sửa sản phẩm</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">Xóa sản phẩm</a>
    </div>
</section>
