@model ShoppingCart

@{
    ViewData["Title"] = "Giỏ hàng";
    var currency = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<section class="store-heading">
    <div>
        <p class="section-kicker">Giỏ hàng</p>
        <h1>Giỏ hàng của bạn</h1>
        <p class="text-secondary mb-0">Cập nhật số lượng hoặc tiến hành đặt hàng.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index">Tiếp tục mua</a>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!Model.Items.Any())
{
    <div class="empty-panel">
        <h2 class="h4">Giỏ hàng đang trống</h2>
        <p class="text-secondary">Hãy chọn một sản phẩm để bắt đầu đặt hàng.</p>
        <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Xem sản phẩm</a>
    </div>
}
else
{
    <div class="table-responsive cart-table">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="cart-product">
                                <img src="@item.ImageUrl" alt="@item.Name" />
                                <span>@item.Name</span>
                            </div>
                        </td>
                        <td>@item.Price.ToString("C0", currency)</td>
                        <td>
                            <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input class="form-control quantity-input" type="number" name="quantity" value="@item.Quantity" min="0" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Lưu</button>
                            </form>
                        </td>
                        <td class="fw-semibold">@item.LineTotal.ToString("C0", currency)</td>
                        <td class="text-end">
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Tổng cộng</th>
                    <th colspan="2">@Model.TotalPrice.ToString("C0", currency)</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <a class="btn btn-primary btn-lg" asp-action="Checkout">Đặt hàng</a>
    </div>
}
