# Sao chép file này thành ".env" rồi điền thông tin. KHÔNG đưa file .env lên GitHub.

# --- Telegram (khuyên dùng cho demo) ---
# 1. Trên Telegram, chat với @BotFather, gõ /newbot, làm theo hướng dẫn -> nhận BOT TOKEN
# 2. Chat 1 tin bất kỳ với bot vừa tạo
# 3. Mở https://api.telegram.org/bot<TOKEN>/getUpdates  -> tìm "chat":{"id": ...} -> đó là CHAT ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (tùy chọn). Với Gmail cần tạo "App password" ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
